# Database — use app_user for running the app (RLS enforced); 
# switch to the rag user only when running schema migrations (see README).
DATABASE_URL="postgresql://app_user:app_user_dev_password@localhost:5432/rag_db"

# Server
PORT=4000
JWT_SECRET=replace_with_a_long_random_string

# Ollama (running natively on host, not in Docker)
OLLAMA_BASE_URL=http://localhost:11434

# Reranker service
RERANKER_URL=http://localhost:8001